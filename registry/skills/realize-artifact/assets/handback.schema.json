{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory handback v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "jobDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "partial"
      ]
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "file"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          }
        },
        "required": [
          "path",
          "sha256",
          "kind",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": [
              "string",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "before",
          "after"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "input",
          "sections",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "mapped",
              "approximated",
              "degraded",
              "unsupported"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "subject",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "provenance": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": [
            "original",
            "inspired",
            "adapted"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "disposition",
        "evidence",
        "findings"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "jobDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executable": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "startedAt": {
            "type": "string",
            "minLength": 1
          },
          "endedAt": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "classification": {
            "enum": [
              "passed",
              "failed",
              "skipped",
              "unavailable"
            ]
          },
          "stdout": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "stderr": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "jobDigest",
          "executable",
          "argv",
          "cwd",
          "startedAt",
          "endedAt",
          "exitCode",
          "classification",
          "stdout",
          "stderr"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "findings"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "status",
        "findings"
      ],
      "additionalProperties": false
    },
    "live": {
      "type": "object",
      "properties": {
        "status": {
          "const": "unverified"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "upstream": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "base": {
          "const": "dev"
        },
        "sent": {
          "const": false
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "base",
        "sent",
        "template",
        "body"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "jobId",
    "jobDigest",
    "status",
    "inventory",
    "diff",
    "coverage",
    "deltas",
    "provenance",
    "checks",
    "quality",
    "live",
    "openItems",
    "upstream"
  ],
  "additionalProperties": false
}
