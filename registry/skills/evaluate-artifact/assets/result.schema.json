{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller-saved factory evaluation opinion v2",
  "type": "object",
  "properties": {
    "version": {
      "const": 2
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "jobDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "reviewed",
        "partial",
        "blocked"
      ]
    },
    "opinion": {
      "enum": [
        "no-blocking-findings",
        "changes-requested",
        "inconclusive"
      ]
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "shared-pair",
            "skill",
            "claude-agent",
            "rule"
          ]
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "host": {
              "const": "claude"
            },
            "product": {
              "const": "Claude Code CLI"
            },
            "scope": {
              "const": "workspace"
            },
            "lane": {
              "const": "native"
            },
            "observedVersion": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            },
            "unverifiedReason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "host",
            "product",
            "scope",
            "lane",
            "observedVersion",
            "unverifiedReason"
          ],
          "additionalProperties": false
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1,
          "maxItems": 32
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "identity",
        "target",
        "paths",
        "definition"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "kind": {
            "const": "file"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "kind",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "status": {
            "enum": [
              "reviewed",
              "preservation-only",
              "unavailable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "path",
          "status",
          "rationale"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 32
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "task-fit",
              "shared-semantics",
              "host-fit",
              "dependency-usefulness",
              "evidence-truthfulness",
              "provenance-ownership",
              "clarity-maintainability",
              "coverage-evidence"
            ]
          },
          "outcome": {
            "enum": [
              "satisfactory",
              "needs-work",
              "unverified",
              "not-applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 80
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "sourceId",
                "path",
                "sha256",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "outcome",
          "rationale",
          "citations"
        ],
        "additionalProperties": false
      },
      "minItems": 8,
      "maxItems": 8
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "criterionId": {
            "enum": [
              "task-fit",
              "shared-semantics",
              "host-fit",
              "dependency-usefulness",
              "evidence-truthfulness",
              "provenance-ownership",
              "clarity-maintainability",
              "coverage-evidence"
            ]
          },
          "severity": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "INFO"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 80
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              },
              "required": [
                "sourceId",
                "path",
                "sha256",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 8
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "correction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "criterionId",
          "severity",
          "confidence",
          "citations",
          "rationale",
          "correction"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "deterministicEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "not-run"
            ]
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "rawSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "receiptSha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "status",
          "exit",
          "rawSha256",
          "receiptSha256",
          "observation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 1,
      "maxItems": 32
    },
    "live": {
      "const": "unverified"
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "dependentAcceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "minItems": 0,
            "maxItems": 32
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "description",
          "dependentAcceptance",
          "provider"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "acceptedDraft": {
      "const": false
    },
    "inventorySource": {
      "const": "caller-provided"
    }
  },
  "required": [
    "version",
    "jobId",
    "jobDigest",
    "candidateDigest",
    "status",
    "opinion",
    "subject",
    "inventory",
    "coverage",
    "criteria",
    "findings",
    "deterministicEvidence",
    "limitations",
    "live",
    "openItems",
    "acceptedDraft",
    "inventorySource"
  ],
  "additionalProperties": false
}
