          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "minItems": 0,
            "maxItems": 24
          },
          "status": {
            "enum": [
              "clear",
              "held",
              "unavailable"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "bytes",
          "sha256",
          "sections",
          "status",
          "required"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "runtime": {
      "type": "object",
      "properties": {
        "executable": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "checker": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 134217728
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "executable",
        "checker"
      ],
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": 1
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "task-fit",
                  "shared-semantics",
                  "host-fit",
                  "dependency-usefulness",
                  "evidence-truthfulness",
                  "provenance-ownership",
                  "clarity-maintainability"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "applicable": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
