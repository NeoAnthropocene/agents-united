    "budget": {
      "type": "object",
      "properties": {
        "maxCandidateFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "maxCandidateFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maxCandidateBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxEvidenceFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "maxEvidenceFileBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "maxEvidenceBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "maxResultBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "maxFindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "maxOpenItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "maxChecks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "maxSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "maxLogBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "maxExecutableBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "externalCalls": {
          "const": 0
        },
        "publication": {
          "const": false
        },
        "repair": {
          "const": false
        }
      },
      "required": [
        "maxCandidateFiles",
        "maxCandidateFileBytes",
        "maxCandidateBytes",
        "maxEvidenceFiles",
        "maxEvidenceFileBytes",
        "maxEvidenceBytes",
        "maxResultBytes",
        "maxFindings",
        "maxOpenItems",
        "maxChecks",
        "maxSeconds",
        "maxLogBytes",
        "maxExecutableBytes",
        "externalCalls",
        "publication",
        "repair"
