  "required": [
    "version",
    "id",
    "operation",
    "intent",
    "authoringHost",
    "subject",
    "objective",
    "fixedValues",
    "constraints",
    "acceptance",
    "source",
    "roots",
    "candidate",
    "inputs",
    "runtime",
    "rubric",
    "checks",
    "provenance",
    "budget"
