        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1,
          "maxItems": 32
        },
        "definition": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "identity",
        "target",
        "paths",
        "definition"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "fixedValues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
