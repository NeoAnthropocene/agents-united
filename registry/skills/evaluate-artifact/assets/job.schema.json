            "sourceId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "licenceId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "comparisonId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 80
            },
            "noticeIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "maxLength": 80
              },
              "minItems": 0,
              "maxItems": 32
            }
          },
          "required": [
            "sourceId",
            "licenceId",
            "comparisonId",
            "noticeIds"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "disposition",
        "author",
        "evidence",
        "unresolved",
        "notices"
      ],
      "additionalProperties": false
