        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "registry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "checkout",
        "head",
        "registry"
      ],
      "additionalProperties": false
    },
    "roots": {
      "type": "object",
      "properties": {
        "candidate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1,
          "maxItems": 64
        },
        "review": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "managed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 0,
          "maxItems": 32
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 0,
          "maxItems": 32
        }
      },
      "required": [
        "candidate",
        "read",
        "review",
        "managed",
        "protected"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "kind": {
                "const": "file"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 262144
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "enum": [
                  "subject",
                  "support",
                  "preservation-only"
                ]
              }
