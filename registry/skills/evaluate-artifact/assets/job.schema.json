        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable",
              "not-run"
            ]
          },
          "command": {
            "type": "object",
            "properties": {
              "executable": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "bytes": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 134217728
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "minItems": 0,
                "maxItems": 24
              },
              "cwd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              }
            },
            "required": [
              "executable",
              "argv",
              "cwd"
            ],
            "additionalProperties": false
          },
          "candidateDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "raw": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 134217728
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          },
          "receipt": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 134217728
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "required",
          "status",
          "command",
          "candidateDigest",
          "exit",
          "raw",
          "receipt"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 6
