    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "shared-core",
              "shared-contract",
              "guide",
              "snapshot",
              "observation",
              "profile",
              "tool-policy",
              "library-lock",
              "loading",
              "rule",
              "guard",
              "source",
              "provenance",
              "baseline",
              "diff",
              "validator",
              "template"
