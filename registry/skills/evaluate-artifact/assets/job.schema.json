{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed factory evaluation job v1",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "operation": {
      "const": "review"
    },
    "intent": {
      "enum": [
        "local",
        "upstream"
      ]
    },
    "authoringHost": {
      "type": "object",
      "properties": {
        "host": {
          "const": "claude"
        },
        "product": {
          "const": "Claude Code CLI"
        },
        "scope": {
          "const": "workspace"
        },
        "lane": {
          "const": "native"
        },
        "observedVersion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192
        },
        "unverifiedReason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "host",
        "product",
        "scope",
        "lane",
        "observedVersion",
        "unverifiedReason"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "shared-pair",
            "skill",
            "claude-agent"
          ]
        },
        "identity": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 80
        },
        "target": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "host": {
              "const": "claude"
            },
            "product": {
              "const": "Claude Code CLI"
            },
            "scope": {
              "const": "workspace"
            },
            "lane": {
              "const": "native"
            },
            "observedVersion": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            },
            "unverifiedReason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 8192
            }
          },
          "required": [
            "host",
            "product",
            "scope",
            "lane",
            "observedVersion",
            "unverifiedReason"
