    "provenance": {
      "type": "object",
      "properties": {
        "disposition": {
          "enum": [
            "original",
            "inspired",
            "adapted"
          ]
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "minItems": 1,
          "maxItems": 32
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 0,
          "maxItems": 16
        },
        "notices": {
          "type": "array",
