{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed Skill authoring return v1 (every field is an unaccepted claim)",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "skill-return"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "blocked"
      ]
    },
    "helper": {
      "type": "object",
      "properties": {
        "draftJob": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4194304
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "stdout": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4194304
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "stderr": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65536
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "additionalProperties": false
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "draftJob",
        "stdout",
        "stderr",
        "exitCode",
        "runs"
      ],
      "additionalProperties": false
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 262144
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "operation": {
            "enum": [
              "create",
              "update"
            ]
          }
        },
        "required": [
          "path",
          "operation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "report": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false
    },
    "claimedChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255
          },
          "raw": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 524288
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "command",
          "exitCode",
          "raw"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 0,
      "maxItems": 32
    },
    "externalActions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      },
      "minItems": 0,
      "maxItems": 16
    }
  },
  "required": [
    "version",
    "kind",
    "taskId",
    "taskDigest",
    "status",
    "helper",
    "inventory",
    "changed",
    "report",
    "claimedChecks",
    "openItems",
    "unverified",
    "externalActions"
  ],
  "additionalProperties": false
}
