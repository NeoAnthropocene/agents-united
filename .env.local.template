# Agents United - Environment Secrets Template
# Copy this file to .env.local and fill in your actual tokens.
# WARNING: Do NOT commit .env.local to version control!

# -----------------------------------------------------------------------------
# NPM Publish Configuration
# -----------------------------------------------------------------------------
# 1. Go to https://www.npmjs.com/settings/neoanthropocene/tokens
# 2. Generate a new "Automation" token with Publish access.
# 3. Paste the token below:
NPM_TOKEN=npm_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GitHub Automation Configuration
# -----------------------------------------------------------------------------
# Personal Access Token (classic with `repo` scope or fine-grained token with
# Contents: Read/Write, Issues: Read/Write, Pull Requests: Read/Write)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
