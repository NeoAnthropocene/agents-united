{
  "$comment": "PetPal hero tokens. Contrast (WCAG relative luminance, hand-computed): cta.primaryText on cta.primary = 5.56:1 (AA normal text); text.primary on surface.page = 13.9:1; text.secondary on surface.page = 6.8:1; cta.primary on surface.page = 5.3:1 (3:1 needed for UI component).",
  "color": {
    "cta": { "primary": "#B8400F", "primaryText": "#FFFFFF", "focusRing": "#0F4C4A" },
    "text": { "primary": "#1F2A2E", "secondary": "#4A5A5F" },
    "surface": { "page": "#FFF8F0", "alt": "#F3E3CF", "trust": "#E3F0EE" },
    "brand": { "deep": "#0F4C4A" }
  },
  "font": {
    "family": { "display": "Fraunces, Georgia, serif", "body": "Inter, system-ui, sans-serif" },
    "weight": { "regular": 400, "semibold": 600, "bold": 700 }
  },
  "typeScale": {
    "hero":    { "size": "3.5rem",   "lineHeight": 1.1,  "weight": "bold" },
    "heroSub": { "size": "1.25rem",  "lineHeight": 1.5,  "weight": "regular" },
    "body":    { "size": "1rem",     "lineHeight": 1.6,  "weight": "regular" },
    "cta":     { "size": "1.125rem", "lineHeight": 1.2,  "weight": "semibold" },
    "caption": { "size": "0.875rem", "lineHeight": 1.4,  "weight": "regular" }
  },
  "spacing": { "xs": "0.5rem", "sm": "1rem", "md": "1.5rem", "lg": "3rem", "xl": "5rem" },
  "radius": { "button": "0.75rem", "card": "1.25rem" },
  "size": { "touchTargetMin": "48px", "heroMaxWidth": "72rem" }
}
